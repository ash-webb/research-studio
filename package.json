  "version": "0.3.9",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/participant-flows.cjs",
    "test:a11y": "node tests/e2e/accessibility-scan.cjs",
